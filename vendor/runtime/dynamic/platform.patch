+// APK native files have packaging names; introspection must expose the guest ABI names.
+static const char* guest_library_name(soinfo* si) {
+  const char* physical = si->get_realpath();
+  const char* host = getenv("A10VM_HOST_ROOT");
+  const char* root = getenv("A10VM_ROOTFS");
+  if (host == nullptr || root == nullptr ||
+      strncmp(physical, host, strlen(host)) != 0 || physical[strlen(host)] != '/') {
+    return physical;
+  }
+  static std::unordered_map<std::string, std::string> names;
+  auto found = names.find(physical);
+  if (found != names.end()) return found->second.c_str();
+  const char* soname = si->get_soname();
+  std::string logical;
+  if (si == solist_get_head()) logical = "/system/bin/linker64";
+  else if (soname != nullptr && strchr(soname, '/') == nullptr) {
+    logical = std::string("/system/lib64/") + soname;
+  } else return physical;
+  struct stat actual, alias;
+  if (linkerPathStat(physical, &actual) != 0) return physical;
+  const char* runtime = getenv("ANDROID_RUNTIME_ROOT");
+  if (si != solist_get_head() && runtime != nullptr && runtime[0] == '/' && soname != nullptr) {
+    std::string candidate = std::string(runtime) + "/lib64/" + soname;
+    if (linkerPathStat(candidate.c_str(), &alias) == 0 &&
+        actual.st_dev == alias.st_dev && actual.st_ino == alias.st_ino) logical = std::move(candidate);
+  }
+  if (linkerPathStat(logical.c_str(), &alias) != 0 ||
+      actual.st_dev != alias.st_dev || actual.st_ino != alias.st_ino) return physical;
+  return names.emplace(physical, std::move(logical)).first->second.c_str();
+}
