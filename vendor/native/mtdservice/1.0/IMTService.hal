package vendor.xiaomi.hardware.mtdservice@1.0;

interface IMTService {
    getFid() generates (string fid);
    eccSign(int32_t keyType, string text) generates (string signature);
    reload(string text, string signature) generates (int32_t result);
    enroll(string appname, int32_t enrollType) generates (string result);
    ifaa_key_get_version() generates (int32_t version);
    ifaa_key_prepare() generates (string result);
    ifaa_key_load(string data, string signature) generates (int32_t result);
    fido_key_get_version() generates (int32_t version);
    fido_key_prepare() generates (string result);
    fido_key_load(string data, string signature) generates (int32_t result);
    soter_generate() generates (string result);
    soter_get_state() generates (int32_t state);
    soter_set_state(int32_t state);
};
