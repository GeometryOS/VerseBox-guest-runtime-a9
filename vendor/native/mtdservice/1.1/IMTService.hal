package vendor.xiaomi.hardware.mtdservice@1.1;

import @1.0::IMTService;

interface IMTService extends @1.0::IMTService {
    persist_read(int32_t directory, string name) generates (int32_t result, vec<int8_t> data);
    persist_write(int32_t directory, string name, vec<int8_t> data, int32_t length) generates (int32_t result);
    persist_remove(int32_t directory, string name) generates (int32_t result);
    ifaa_key_dump() generates (string result);
};
