# Private Binder/HwBinder uses AF_UNIX instead of the kernel Binder driver.
socket: arg0 == 1
connect: 1
sendmsg: 1
recvmsg: 1
sendto: 1
recvfrom: 1
getsockopt: 1
setsockopt: 1
shutdown: 1
fcntl: 1
memfd_create: 1
ftruncate: 1
ppoll: 1
# Process/thread identity and clock queries made by the transport and Bionic.
getpid: 1
gettid: 1
getuid: 1
geteuid: 1
getgid: 1
getegid: 1
clock_gettime: 1
rt_sigprocmask: 1
set_tid_address: 1
getpriority: 1
sched_get_priority_max: 1
sched_get_priority_min: 1
sched_setscheduler: 1
